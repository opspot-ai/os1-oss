# OS1 bridge configuration.
#
# Copy to `.env` at the repository root and fill in what you need.
# `.env` is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Interface and port the bridge listens on. 0.0.0.0 makes it reachable from
# your phone on the same network; use 127.0.0.1 to keep it Mac-only.
HOST=0.0.0.0
PORT=8788

# Shared secret every /api/* request must present as `X-OS1-Token` (or an
# `os1_token` cookie). If left empty the bridge does NOT authenticate requests
# — only do that on a machine nothing else can reach.
# scripts/run-local.sh generates one for you on first run.
OS1_ACCESS_TOKEN=

# File the generated access token is written to. The iOS bootstrap script
# reads the same file.
# OS1_TOKEN_FILE=/YOUR/LOCAL/TOKEN/FILE

# ---------------------------------------------------------------------------
# Backend: demo | local | orgo
# ---------------------------------------------------------------------------
#   demo   sample data, no credentials required
#   local  a local agent CLI on this Mac
#   orgo   a remote Orgo cloud computer
OS1_BACKEND=demo

# ---------------------------------------------------------------------------
# local backend — your agent CLI
# ---------------------------------------------------------------------------
# Executable to invoke. A bare name is resolved from PATH.
AGENT_CLI_BIN=agent
# The CLI's state directory. The bridge reads `state.db` (sessions) and
# `kanban.db` (tasks) from here with sqlite3, read-only.
AGENT_HOME=
# Working directory the CLI runs in — your agent's workspace/repo.
AGENT_WORKSPACE_DIR=
# Flags used to build `<bin> <profileFlag> <profile> <promptFlag> <prompt>`.
AGENT_CLI_PROFILE_FLAG=-p
AGENT_CLI_PROMPT_FLAG=-z
# Which CLI profile answers each app mode.
AGENT_PROFILE_ASSISTANT=assistant
AGENT_PROFILE_NOTE=note
AGENT_PROFILE_ROUTER=router
# Subcommand (comma separated) used to create a task/card.
AGENT_TASK_SUBCOMMAND=kanban,create
AGENT_TASK_ASSIGNEE=default
# Colon-separated allow-list of folders the search tool may read, absolute or
# relative to AGENT_WORKSPACE_DIR. Default is the workspace root.
AGENT_CONTEXT_PATHS=.
# Extra environment passed to the CLI, as JSON. Example: {"MY_CLI_FLAG":"1"}
AGENT_CLI_ENV={}
# Binary used for the full-text search tool.
RG_BIN=rg

# ---------------------------------------------------------------------------
# Optional remote Orgo computer backend.
# ---------------------------------------------------------------------------
ORGO_API_KEY=
ORGO_COMPUTER_ID=
ORGO_BASE=https://YOUR-ORGO-HOST
ORGO_CLI=orgo

# ---------------------------------------------------------------------------
# OpenAI — realtime voice and transcription
# ---------------------------------------------------------------------------
# Held only by the bridge. The phone receives short-lived client secrets, never
# this key.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
# 0.0–1.0. Lower opens a turn on quieter speech.
OPENAI_REALTIME_VAD_THRESHOLD=0.15
# near_field | far_field
OPENAI_REALTIME_NOISE_REDUCTION=far_field
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Upload ceilings, in bytes.
OPENAI_TRANSCRIPTION_MAX_AUDIO_BYTES=25165824
OS1_NOTE_CAPTURE_MAX_JSON_BYTES=44040192

# ---------------------------------------------------------------------------
# Voice-note captures
# ---------------------------------------------------------------------------
# Where transcripts, capture records, queue packets and receipts are written.
# Default: <AGENT_WORKSPACE_DIR>/os1-captures
OS1_CAPTURE_ROOT=
# IANA timezone used to stamp captures. Defaults to the system timezone.
OS1_LOCAL_TIME_ZONE=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# A local dashboard the voice mode can health-check.
OS1_DASHBOARD_URL=http://YOUR-DASHBOARD-HOST:PORT
